/*
 * Partner A owns this file. Rename to connect_process_group.cpp and add it to
 * CMake only after the real RDMA transport constructor is available.
 */

#include "process_group_api.h"

extern "C" int connect_process_group(char* servername, void** pg_handle) {
    if (servername == nullptr || pg_handle == nullptr) {
        return PG_ERR_INVALID_ARGUMENT;
    }

    pg_transport_t* transport = nullptr;

    /*
     * TODO(Partner A):
     * 1. Parse rank/world-size/bootstrap configuration.
     * 2. Allocate PD, CQ, QPs, MRs and control buffers.
     * 3. Connect previous/next neighbors in the ring.
     * 4. Wrap the implementation in pg_transport_t with pg_transport_ops_t.
     */
    const int transport_status = -1; // rdma_transport_connect(..., &transport);
    if (transport_status != 0) {
        return PG_ERR_TRANSPORT;
    }

    ring_collective_config_t config{};
    config.pipeline_piece_bytes = 64U * 1024U;
    config.max_inflight = 4;
    config.transfer_mode = PG_TRANSFER_AUTO;

    /* pg_close() will own and destroy transport because the flag is 1. */
    const int status = pg_create_from_transport(transport, 1, &config, pg_handle);
    if (status != PG_SUCCESS) {
        pg_transport_destroy(transport);
    }
    return status;
}
